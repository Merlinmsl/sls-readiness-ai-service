SERVICE_NAME=sls-readiness-ai-service
SERVICE_TITLE=SLS Readiness AI Service
SERVICE_VERSION=0.5.0
ENVIRONMENT=development
API_V1_PREFIX=/v1

# Use mock during tests and normal local development.
AI_PROVIDER=mock

# Never place a real key in this example file.
GEMINI_API_KEY=

# Current configured model. Change through environment variables if needed.
GEMINI_MODEL=gemini-3.6-flash